#!/bin/sh /etc/rc.common

START=99

wait_for_download_path() {
    url=$1
    interface='{{ getdomains_download_interface }}'
    host=${url#*://}
    host=${host%%/*}
    host=${host%%:*}
    waited=0

    while [ "$waited" -lt {{ getdomains_ready_timeout | int }} ]; do
        if ip link show dev "$interface" >/dev/null 2>&1 && \
            nslookup "$host" >/dev/null 2>&1; then
            return 0
        fi
        waited=$((waited + 1))
        sleep 1
    done
    logger -t getdomains "download path is not ready: interface=$interface host=$host"
    return 1
}

download() {
    url=$1
    destination=$2
    temporary="${destination}.tmp.$$"

    rm -f "$temporary"
    wait_for_download_path "$url" || return 1
    if ! curl -fL --interface '{{ getdomains_download_interface }}' \
        --connect-timeout {{ getdomains_connect_timeout | int }} \
        --max-time {{ getdomains_max_time | int }} --retry {{ getdomains_retries | int }} \
        --retry-delay 2 "$url" -o "$temporary"; then
        rm -f "$temporary"
        logger -t getdomains "download failed: $url"
        return 1
    fi
    [ -s "$temporary" ] || { rm -f "$temporary"; return 1; }
}

install_download() {
    destination=$1
    temporary="${destination}.tmp.$$"
    if [ -f "$destination" ] && cmp -s "$temporary" "$destination"; then
        rm -f "$temporary"
        return 1
    fi
    mv -f "$temporary" "$destination"
}

start() {
    lock=/var/lock/getdomains.lock
    if ! mkdir "$lock" 2>/dev/null; then
        logger -t getdomains "refresh is already running"
        return 0
    fi
    cleanup() {
        rm -rf "$lock"
        rm -f /tmp/dnsmasq.d/domains.lst.tmp.$$ /tmp/lst/*.tmp.$$
    }
    trap cleanup 0
    trap 'exit 1' HUP INT TERM

    failed=0
    dnsmasq_changed=0
    firewall_changed=0
    mkdir -p /tmp/dnsmasq.d /tmp/lst

{% if list_domains %}
    domains=/tmp/dnsmasq.d/domains.lst
    if download '{{ domain_list_urls[country] }}' "$domains"; then
        if dnsmasq --conf-file="${domains}.tmp.$$" --test >/dev/null 2>&1; then
            install_download "$domains" && dnsmasq_changed=1
        else
            rm -f "${domains}.tmp.$$"
            logger -t getdomains "downloaded domain list failed dnsmasq validation"
            failed=1
        fi
    else
        failed=1
    fi
{% endif %}
{% for item in [
    {'enabled': list_subnet, 'url': subnet_list_url, 'file': 'subnet.lst'},
    {'enabled': list_ip, 'url': ip_list_url, 'file': 'ip.lst'},
    {'enabled': list_community, 'url': community_list_url, 'file': 'community.lst'}
] %}
{% if item.enabled %}
    destination=/tmp/lst/{{ item.file }}
    if download '{{ item.url }}' "$destination"; then
        install_download "$destination" && firewall_changed=1
    else
        failed=1
    fi
{% endif %}
{% endfor %}

    [ "$dnsmasq_changed" -eq 0 ] || /etc/init.d/dnsmasq restart
    [ "$firewall_changed" -eq 0 ] || /etc/init.d/firewall restart
    return "$failed"
}
